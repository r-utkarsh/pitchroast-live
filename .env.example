# Nexconn credentials. Copy to .env and fill in. Never commit .env.
NEXCONN_APP_KEY=
NEXCONN_APP_SECRET=
NEXCONN_REGION=singapore

# Optional: override the Server API base URL (defaults by region).
# NEXCONN_API_BASE_URL=https://api.sg-light-api.com

# Optional: only needed if you want to expose a client key different from NEXCONN_APP_KEY.
# VITE_NEXCONN_APP_KEY=
